<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="dashboard-title">
      Tasks
    </h2>

    <p class="dashboard-subtitle">
      Manage and track project tasks.
    </p>

  </div>

  <button
    class="btn btn-primary"
    data-bs-toggle="modal"
    data-bs-target="#createTaskModal"
  >
    <i class="bi bi-plus-lg"></i>
    Create Task
  </button>

</div>

<!-- Tasks Table -->

<div class="dashboard-card">

  <div class="table-responsive">

    <table class="table modern-table">

      <thead>

        <tr>
          <th>Task</th>
          <th>Project</th>
          <th>Assigned To</th>
          <th>Status</th>
          <th>Priority</th>
          <th>Due Date</th>
          <th>Actions</th>
        </tr>

      </thead>

      <tbody>

        <% if (tasks.length > 0) { %>

          <% tasks.forEach(task => { %>

            <tr class="
              <%= new Date(task.dueDate) < new Date()
              && task.status !== 'DONE'
              ? 'overdue-row'
              : '' %>
            ">

              <td>
                <strong>
                  <%= task.title %>
                </strong>
              </td>

              <td>
                <%= task.project.name %>
              </td>

              <td>
                <%= task.assignedTo.name %>
              </td>

              <td>

                <span class="
                  badge
                  status-badge
                  <%= task.status %>
                ">

                  <%= task.status %>

                </span>

              </td>

              <td>

                <span class="
                  badge
                  priority-badge
                  <%= task.priority %>
                ">

                  <%= task.priority %>

                </span>

              </td>

              <td>

                <%= new Date(task.dueDate)
                .toLocaleDateString() %>

              </td>

              <td>

                <form
                  action="/tasks/<%= task.id %>/status"
                  method="POST"
                >

                  <select
                    name="status"
                    class="form-select form-select-sm"
                    onchange="this.form.submit()"
                  >

                    <option
                      value="TODO"
                      <%= task.status === 'TODO'
                      ? 'selected'
                      : '' %>
                    >
                      TODO
                    </option>

                    <option
                      value="IN_PROGRESS"
                      <%= task.status === 'IN_PROGRESS'
                      ? 'selected'
                      : '' %>
                    >
                      IN PROGRESS
                    </option>

                    <option
                      value="DONE"
                      <%= task.status === 'DONE'
                      ? 'selected'
                      : '' %>
                    >
                      DONE
                    </option>

                  </select>

                </form>

              </td>

            </tr>

          <% }) %>

        <% } else { %>

          <tr>

            <td colspan="7">

              <div class="empty-state py-5">

                <i class="bi bi-list-task"></i>

                <h4>
                  No Tasks Found
                </h4>

              </div>

            </td>

          </tr>

        <% } %>

      </tbody>

    </table>

  </div>

</div>

<!-- Create Task Modal -->

<div
  class="modal fade"
  id="createTaskModal"
  tabindex="-1"
>

  <div class="modal-dialog modal-lg">

    <div class="modal-content modern-modal">

      <div class="modal-header">

        <h5 class="modal-title">
          Create Task
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>

      </div>

      <form
        action="/tasks/create"
        method="POST"
      >

        <div class="modal-body">

          <div class="row">

            <div class="col-md-6 mb-3">

              <label>
                Task Title
              </label>

              <input
                type="text"
                name="title"
                class="form-control"
                required
              />

            </div>

            <div class="col-md-6 mb-3">

              <label>
                Project
              </label>

              <select
                name="projectId"
                class="form-select"
                required
              >

                <% projects.forEach(project => { %>

                  <option
                    value="<%= project.id %>"
                  >
                    <%= project.name %>
                  </option>

                <% }) %>

              </select>

            </div>

          </div>

          <div class="mb-3">

            <label>
              Description
            </label>

            <textarea
              name="description"
              rows="4"
              class="form-control"
            ></textarea>

          </div>

          <div class="row">

            <div class="col-md-4 mb-3">

              <label>
                Priority
              </label>

              <select
                name="priority"
                class="form-select"
              >

                <option value="LOW">
                  LOW
                </option>

                <option value="MEDIUM">
                  MEDIUM
                </option>

                <option value="HIGH">
                  HIGH
                </option>

              </select>

            </div>

            <div class="col-md-4 mb-3">

              <label>
                Assign User
              </label>

              <select
                name="assignedToUserId"
                class="form-select"
              >

                <% users.forEach(user => { %>

                  <option
                    value="<%= user.id %>"
                  >
                    <%= user.name %>
                  </option>

                <% }) %>

              </select>

            </div>

            <div class="col-md-4 mb-3">

              <label>
                Due Date
              </label>

              <input
                type="date"
                name="dueDate"
                class="form-control"
                required
              />

            </div>

          </div>

        </div>

        <div class="modal-footer">

          <button
            type="submit"
            class="btn btn-primary"
          >
            Create Task
          </button>

        </div>

      </form>

    </div>

  </div>

</div>